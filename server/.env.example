PORT=5000
DATABASE_URL=./lm_tailor.db
# For production/Vercel, use a cloud connection string:
# DATABASE_URL=libsql://your-db-url

# ── Environment ──────────────────────────────────────────────────────────────
# Set to 'production' on Vercel / hosted server. NEVER set to 'production' locally.
NODE_ENV=development

# ── Razorpay (for local dev, use test keys from dashboard.razorpay.com) ──────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
# Required in production — set in Razorpay Dashboard under Webhooks
RAZORPAY_WEBHOOK_SECRET=
